{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/adaptive/daily-sweep",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/push/daily-reminder",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/push/streak-check",
      "schedule": "0 19 * * *"
    }
  ]
}
